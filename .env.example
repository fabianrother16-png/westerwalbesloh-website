# Anthropic API (KI-Berater-Chat) - server-side only, never exposed to the client
ANTHROPIC_API_KEY=
# Optional: overrides the default chat model (see src/lib/anthropic.ts)
CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001

# Resend (transaktionale E-Mails aus dem Kontaktformular)
RESEND_API_KEY=
# Absenderadresse - muss eine in Resend verifizierte Domain sein
CONTACT_FROM_EMAIL="Westerwalbesloh Website <formular@ihre-domain.de>"
# Empfänger des Kontaktformulars
CONTACT_TO_EMAIL=westerwalbesloh_gmbh@t-online.de

# Basis-URL der Seite (für Sitemap, JSON-LD, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sonnenschutz-westerwalbesloh.de

# Statistik: Google Analytics 4 und Microsoft Clarity laden nur nach Einwilligung im
# Cookie-Banner und nur im Produktionsbuild. Ohne Eintrag gelten die IDs der bisherigen
# Seite; der Wert "off" schaltet den jeweiligen Dienst ab (z. B. für Vorschau-Deployments).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7DVDHX6NLD
# NEXT_PUBLIC_CLARITY_PROJECT_ID=utosndrm9n
