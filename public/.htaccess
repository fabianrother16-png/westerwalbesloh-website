# Westerwalbesloh – statische Next.js-Seite auf Apache (All-Inkl)

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer https und ohne www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://sonnenschutz-westerwalbesloh.de%{REQUEST_URI} [R=301,L]

  # Alte Adressen, die Google noch kennt
  RewriteRule ^produkt/insektenschutz-.* /produkte/insektentschutz [R=301,L]
  RewriteRule ^produkt/.*markise.* /produkte/markisen [R=301,L,NC]
  RewriteRule ^produkt(/.*)?$ /produkte [R=301,L]
  RewriteRule ^produkte/markisen/.+ /produkte/markisen [R=301,L]
  RewriteRule ^produkte/jalousien(/.*)?$ /produkte/sonnenschutz [R=301,L]
  RewriteRule ^produkte/innenliegender-sonnenschutz(/.*)?$ /produkte/sonnenschutz [R=301,L]
  RewriteRule ^produkte/insektenschutz/?$ /produkte/insektentschutz [R=301,L]
  RewriteRule ^service(/.*)?$ /leistungen [R=301,L]

  # Schrägstrich am Ende entfernen (die Seiten liegen als name.html vor)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /kontakt -> kontakt.html (saubere Adressen ohne Endung)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Chat und Kontaktformular laufen über den Cloudflare Worker westerwalbesloh-api.rother-marketing.workers.dev.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://www.instagram.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://westerwalbesloh-api.rother-marketing.workers.dev https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; frame-src https://www.google.com https://www.instagram.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Mikrofon nur für die eigene Seite (Diktierfunktion im Chat)
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"

  # Dateien mit Versions-Hash dürfen lange im Browser bleiben
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
